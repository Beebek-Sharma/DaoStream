# ========================================================
# DaoStream — Unified Media Streaming Hub Configuration
# ========================================================

# Application Settings
APP_NAME="DaoStream"
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY=generate_your_own_secure_32_byte_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default SQLite local database:
DATABASE_URL=sqlite+aiosqlite:///./data/media_hub.db
# PostgreSQL example for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/daostream

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local Media & Books Storage Paths
MEDIA_STORAGE_PATH=./data/media
BOOKS_STORAGE_PATH=./data/books

# Metadata & Streaming Provider API Credentials
# Get your free TMDB API Key from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token_here
OPENLIBRARY_BASE_URL=https://openlibrary.org
