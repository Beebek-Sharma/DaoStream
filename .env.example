# ========================================================
# Personal Unified Media Hub — Environment Configuration
# ========================================================

# Application Settings
APP_NAME="Personal Media Hub"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Security & Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# SQLite default for local development:
DATABASE_URL=sqlite+aiosqlite:///./data/media_hub.db
# PostgreSQL example for production:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/media_hub

# CORS Settings (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Local Storage Paths
MEDIA_STORAGE_PATH="./data/media"
BOOKS_STORAGE_PATH="./data/books"

# Provider Settings (Placeholders for user-authorized API credentials)
# TMDB_API_KEY=
# OPENLIBRARY_BASE_URL=https://openlibrary.org
