{
  "name": "personal-media-hub-root",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Unified Media Hub monorepo",
  "scripts": {
    "dev:api": "powershell -Command \"$env:PYTHONPATH='apps/api'; apps/api/.venv/Scripts/uvicorn.exe src.main:app --reload --port 8000\"",
    "dev:web": "npm run dev --prefix apps/web",
    "test:api": "powershell -Command \"apps/api/.venv/Scripts/pytest.exe -c apps/api/pytest.ini apps/api/tests -v\"",
    "build:web": "npm run build --prefix apps/web",
    "test": "npm run test:api && npm run build:web"
  }
}
